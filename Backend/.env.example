NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
COOKIE_SAME_SITE=lax
TRUST_PROXY_HOPS=0
MONGO_URI=
JWT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Gmail app password, not the regular account password.
EMAIL_PROVIDER=smtp
EMAIL_USER=
EMAIL_PASS=
# Optional HTTPS auth-email transport for hosts blocking SMTP.
# Set EMAIL_PROVIDER=brevo and configure a verified sender.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=PrepWise AI
# Optional; leave unset to use system DNS.
MONGO_DNS_SERVERS=
