# Set these in the service environment before starting uvicorn.
AI_SERVICE_TOKEN=
GOOGLE_GEN_API_KEY=
JD_MODEL=gemini-2.5-flash
RESUME_MODEL=gemini-2.5-flash
REDIS_URL=redis://127.0.0.1:6379/0
# Same Mongo database as Node; optional explicit database name if URI omits it.
MONGO_URI=
MONGO_DB_NAME=
# Same private resume files as Node (shared volume, absolute path).
RESUME_STORAGE_DIR=
# Local OCR fallback; no additional server. Run python scripts/setup_ocr.py once.
OCR_PROVIDER=tesseract
OCR_LANGUAGES=eng
# Optional override; defaults to ai-service/.ocr/tessdata. Must be an absolute path.
OCR_TESSDATA_DIR=
